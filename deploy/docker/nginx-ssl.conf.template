# Ancient Antiquity - HTTPS config for the "frontend" container (Docker).
# Mounted as /etc/nginx/templates/default.conf.template; the nginx image replaces ${DOMAIN} at start-up
# and writes the result to /etc/nginx/conf.d/default.conf (other $variables are left untouched).
# Requires the certificate in /etc/letsencrypt/live/${DOMAIN}/ - see DEPLOY.md step A6.

map $uri $aa_cache_control {
    default                 "";
    ~^/assets/              "public, max-age=31536000, immutable";
    /index.html             "no-cache";
    /sw.js                  "no-cache";
    ~\.(?:svg|png|jpe?g|webp|ico|woff2?)$  "public, max-age=604800";
}

# Plain HTTP: ACME challenges + redirect everything else to HTTPS
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }
    location = /api/support/health/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $aa_backend http://backend:8000;
        proxy_set_header Host ${DOMAIN};
        proxy_pass $aa_backend;
    }
    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 10m;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $aa_backend http://backend:8000;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml application/xml;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
    add_header Cache-Control $aa_cache_control;

    proxy_hide_header X-Frame-Options;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Strict-Transport-Security;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 10s;
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;

    location /api/          { proxy_pass $aa_backend; }
    location /django-admin/ { proxy_pass $aa_backend; }
    location /static/       { proxy_pass $aa_backend; }

    location /media/ {
        root /srv;
        access_log off;
        expires 7d;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri =404;
    }

    location /assets/ {
        access_log off;
        try_files $uri =404;
    }

    location = /sw.js {
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
