# Copy to .env and adjust
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (default). For a quick demo without Postgres use: sqlite:///db.sqlite3
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ancient_antiquity

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Razorpay (leave empty to use the demo payment gateway). Test keys start with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Full refund when cancelled at least this many hours before the visit slot (otherwise no refund)
REFUND_FULL_BEFORE_HOURS=24

# How long an unpaid booking holds its seats (minutes)
BOOKING_HOLD_MINUTES=15
# How far ahead visitors can book (days)
BOOKING_WINDOW_DAYS=90

# ------------------------------------------------------------------------------------------------
# Production (see ../DEPLOY.md). Example values only - never commit real secrets.
# ------------------------------------------------------------------------------------------------
# DEBUG=False
# SECRET_KEY=<50+ random chars: python -c "import secrets; print(secrets.token_urlsafe(50))">
# ALLOWED_HOSTS=tickets.example.in,www.tickets.example.in
# DATABASE_URL=postgres://ancient:<db-password>@db:5432/ancient_antiquity   (Docker: host "db"; VM: localhost)
# POSTGRES_PASSWORD=<db-password>          (Docker only: used by the postgres container, must match DATABASE_URL)
# CORS_ALLOWED_ORIGINS=https://tickets.example.in
# CSRF_TRUSTED_ORIGINS=https://tickets.example.in
# FRONTEND_URL=https://tickets.example.in
#
# HTTPS / security headers (only applied when DEBUG=False)
# SECURE_SSL_REDIRECT=True                 (False only while testing over plain http)
# SECURE_HSTS_SECONDS=3600                 (raise to 31536000 once https works everywhere)
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
#
# Logging / errors
# LOG_LEVEL=INFO
# ADMIN_EMAILS=ops@example.in              (unhandled 500 errors are emailed here)
# SERVER_EMAIL=alerts@example.in
# CACHE_DIR=/tmp/ancient_antiquity_cache   (shared rate-limit cache for gunicorn workers)
# MEDIA_ROOT=/app/media                    (Docker default; VM: /srv/ancient-antiquity/media)
#
# Gunicorn (optional overrides)
# GUNICORN_WORKERS=5
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=60
# RUN_MIGRATIONS=1                         (Docker: migrate on container start)
#
# Email (SMTP - e.g. Amazon SES, SendGrid, Zoho, Gmail app password)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Ancient Antiquity <tickets@example.in>
# SUPPORT_EMAIL=support@example.in         (shown on the Contact page; contact-form messages are emailed here)
# SUPPORT_PHONE=+91 00000 00000
#
# Payments - LIVE keys (start with rzp_live_). Webhook URL: https://<your-domain>/api/payments/razorpay/webhook/
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
#
# Google Maps photos for places without a free photo: Places API (New) key, restricted to that API + server IP.
# Then run: python manage.py find_google_places
# GOOGLE_MAPS_API_KEY=
# GOOGLE_PHOTO_CACHE_HOURS=12
#
# SMS / WhatsApp
# SMS_PROVIDER=msg91                       (console | msg91 | twilio)
# SMS_API_KEY=
# SMS_SENDER_ID=ANCANT
#
# GST invoice details
# INVOICE_SELLER_NAME=<Registered company name>
# INVOICE_SELLER_ADDRESS=<Registered address>
# INVOICE_SELLER_GSTIN=<GSTIN>
